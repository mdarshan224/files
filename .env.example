# Required: obtain these from ImageKit dashboard > Developer options
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/mdarshantejomaya

# Generate a long random value, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace_with_a_long_random_secret

# Admin login. Change both before deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-unique-password

# Optional. Default is 3000.
PORT=3000
# Set true only when deployed behind a trusted HTTPS reverse proxy.
TRUST_PROXY=false
# Optional base folder within ImageKit Media Library.
IMAGEKIT_BASE_FOLDER=/SohanSoftEmployeeUploads
